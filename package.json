{
  "name": "omni-ctx",
  "version": "0.1.0",
  "description": "Zero-dependency Web Component context menu",
  "type": "module",
  "main": "./dist/omni-ctx.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/omni-ctx.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "bun run --hot examples/index.html",
    "build": "bun build ./src/index.ts --outdir=./dist --format=esm --target=browser --splitting",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {}
}
